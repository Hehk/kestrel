{
  "name": "kestrel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:check": "node scripts/api-schema.mjs check",
    "api:generate": "node scripts/api-schema.mjs generate",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "profile:diff": "node scripts/profile-diff.mjs",
    "profile:diff:mobile": "node scripts/profile-diff.mjs --viewport=390x844",
    "profile:diff:backend": "cargo test --release --locked --manifest-path backend/Cargo.toml profile_pull_request_diff_ -- --ignored --test-threads=1 --nocapture",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "@tanstack/solid-virtual": "^3.13.35",
    "openapi-fetch": "^0.17.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.0.1",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.9"
  }
}
